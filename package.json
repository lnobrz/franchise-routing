{
  "name": "franchise-lead-routing",
  "version": "1.0.0",
  "private": true,
  "description": "Routes franchise leads from GoHighLevel: AI extraction, state legal check, territory and capacity-based rep assignment.",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/src/server.js",
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "simulate": "tsx scripts/simulate.ts"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.118.0",
    "express": "^5.3.0",
    "openai": "^7.42.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/node": "^24.19.2",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^5.0.5"
  }
}
