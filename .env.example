PORT=3000
# 127.0.0.1 keeps the app behind the reverse proxy; 0.0.0.0 exposes the port
HOST=127.0.0.1

# Shared secret sent by the GHL workflow in the x-webhook-secret header.
# Generate one with: openssl rand -hex 32
WEBHOOK_SECRET=

# GoHighLevel Private Integration token and the sub-account (location) id
GHL_TOKEN=
GHL_LOCATION_ID=
GHL_PIPELINE_NAME=Franchise Sales (Demo)

# Supabase project URL and secret (service role) key. Server side only.
SUPABASE_URL=
SUPABASE_SECRET_KEY=

# OpenAI key and a model that supports structured outputs
OPENAI_API_KEY=
OPENAI_MODEL=
# 0 for most models; leave empty for reasoning models, which reject temperature
AI_TEMPERATURE=0
AI_MIN_CONFIDENCE=0.7

BUSINESS_TIMEZONE=America/New_York
RELEASE_JOB_MINUTES=15
# Unfinished events older than this are recovered or flagged for a person
STALE_EVENT_MINUTES=10

# Only used by `npm run simulate` when the server is not on localhost
# SIMULATE_URL=https://routing.example.com/webhooks/lead
